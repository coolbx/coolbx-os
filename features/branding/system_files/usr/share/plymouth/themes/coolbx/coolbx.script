// Coolbx OS Plymouth splash — ontwerp "papier & inkt" (ADR-0035).
// Nacht (#141210), gecentreerde "coolbx os"-wordmark op 13 % van de schermbreedte
// (min 160 px, max 420 px — nooit vaste pixels, nooit "lomp"), daaronder een ademende mint dot.
// Positie én schaal worden per frame herberekend: vroege boot kan van framebuffer wisselen
// (simpledrm → echte GPU/paneel), wat de venstergeometrie mid-splash verandert.

Window.SetBackgroundTopColor(0.078, 0.071, 0.063);
Window.SetBackgroundBottomColor(0.078, 0.071, 0.063);

logo.src = Image("logo.png");       // grote bron (~1000 px breed), wordt geschaald
dot.src = Image("dot.png");         // 64 px bron
logo.sprite = Sprite();
dot.sprite = Sprite();
logo.sprite.SetZ(10);
dot.sprite.SetZ(10);
last_w = -1;

fun layout() {
    sw = Window.GetWidth();
    sh = Window.GetHeight();
    if (sw != last_w) {
        last_w = sw;
        w = sw * 0.13;
        if (w < 160) w = 160;
        if (w > 420) w = 420;
        h = w * logo.src.GetHeight() / logo.src.GetWidth();
        logo.image = logo.src.Scale(w, h);
        logo.sprite.SetImage(logo.image);
        d = w * 0.088;
        if (d < 12) d = 12;
        dot.image = dot.src.Scale(d, d);
        dot.sprite.SetImage(dot.image);
    }
    logo.y = sh / 2 - logo.image.GetHeight() / 2 - logo.image.GetHeight() * 0.35;
    logo.sprite.SetX(sw / 2 - logo.image.GetWidth() / 2);
    logo.sprite.SetY(logo.y);
    dot.sprite.SetX(sw / 2 - dot.image.GetWidth() / 2);
    dot.sprite.SetY(logo.y + logo.image.GetHeight() + logo.image.GetHeight() * 0.9);
}
layout();

progress = 0;
fun refresh_callback() {
    progress++;
    layout();
    // ademen: ~1,8 s per cyclus bij 50 fps
    opacity = 0.30 + 0.70 * (0.5 + 0.5 * Math.Sin(progress / 14.3));
    dot.sprite.SetOpacity(opacity);
}
Plymouth.SetRefreshFunction(refresh_callback);

// --- bootmeldingen (fsck e.d.) ---
message.sprite = Sprite();
fun message_callback(text) {
    message.image = Image.Text(text, 0.59, 0.56, 0.51);
    message.sprite.SetImage(message.image);
    message.sprite.SetX(20);
    message.sprite.SetY(Window.GetHeight() - 50);
}
Plymouth.SetMessageFunction(message_callback);

// --- wachtwoordprompt (LUKS, indien ooit) ---
fun display_password_callback(prompt, bullets) {
    dot.sprite.SetOpacity(0);
    p.image = Image.Text(prompt, 0.98, 0.97, 0.95);
    p.sprite = Sprite(p.image);
    p.sprite.SetX(Window.GetWidth() / 2 - p.image.GetWidth() / 2);
    p.sprite.SetY(Window.GetHeight() / 2 + 80);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    if (p.sprite) p.sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
