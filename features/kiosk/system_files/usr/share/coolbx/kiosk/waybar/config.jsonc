{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 0,
  "margin-top": 0,
  "modules-left": ["custom/brand", "custom/app"],
  "modules-center": ["clock"],
  "modules-right": ["network", "battery", "custom/exit"],

  "custom/brand": {
    "format": "coolbx <span foreground='#50ce96'>os</span>",
    "tooltip": false
  },
  "custom/app": {
    "exec": "cat /run/coolbx-kiosk/name 2>/dev/null || echo kiosk",
    "interval": "once",
    "format": "  {}",
    "tooltip": false
  },
  "clock": {
    "format": "{:L%a %e %b  %H:%M}",
    "locale": "nl_BE.UTF-8",
    "tooltip": false
  },
  "network": {
    "format-wifi": "wifi {signalStrength}%",
    "format-ethernet": "verbonden",
    "format-disconnected": "geen netwerk",
    "tooltip": false
  },
  "battery": {
    "format": "batterij {capacity}%",
    "format-charging": "laden {capacity}%",
    "format-full": "batterij vol",
    "tooltip": false
  },
  "custom/exit": {
    "format": "Sessie afsluiten",
    "on-click": "/usr/bin/coolbx-kiosk-exit",
    "tooltip": false
  }
}
