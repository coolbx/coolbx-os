#!/usr/bin/env bash
set -euo pipefail

# Coolbx OS — start de vergrendelde kiosk (sway + waybar + browser) voor ÉÉN kiosk-app, als de
# 'coolbx-kiosk'-user op een eigen VT (ADR-0006/0016/0029). Wordt via pkexec gestart door de
# gegenereerde launcher (polkit-regel 49-coolbx-kiosk); pkexec strooit de omgeving leeg, dus een
# leerling kan enkel een app-ID meegeven — URL en policy komen uit de root-only app-registry.
#
#   coolbx-kiosk-start <app-id>
#
# DEV-ONLY: zonder app-id valt het terug op 'test' (bestaat alleen in dev-builds); COOLBX_KIOSK_URL
# overschrijft de URL (alleen bereikbaar voor root/ssh — pkexec geeft geen env door).

KIOSK_USER="coolbx-kiosk"
KIOSK_HOME="/var/lib/coolbx-kiosk"
VT=3
KIOSK_TTY="/dev/tty${VT}"
RETURN_VT="${COOLBX_RETURN_VT:-2}"            # GNOME draait op VT2
RUN_DIR="/run/coolbx-kiosk"
APP_POLICY="/etc/chromium/policies/managed/coolbx-kiosk-app.json"
HOOKS_DIR="/usr/share/coolbx/kiosk/hooks.d"

APP_ID="${1:-test}"
if ! APP_JSON="$(/usr/bin/coolbx-kiosk-apps show "$APP_ID" --json 2>/dev/null)"; then
  echo "coolbx-kiosk-start: onbekende kiosk-app '${APP_ID}'" >&2
  exit 1
fi
APP_NAME="$(printf '%s' "$APP_JSON" | python3 -c 'import json,sys;print(json.load(sys.stdin)["name"])')"
APP_URL="$(printf '%s' "$APP_JSON" | python3 -c 'import json,sys;print(json.load(sys.stdin)["url"])')"
URL="${COOLBX_KIOSK_URL:-$APP_URL}"

# Runtime-staat voor waybar en hooks (wereld-leesbaar; bevat geen geheimen).
mkdir -p "$RUN_DIR"; chmod 0755 "$RUN_DIR"
printf '%s\n' "$APP_ID" > "$RUN_DIR/app"
printf '%s\n' "$APP_NAME" > "$RUN_DIR/name"

# Ephemeral home op tmpfs (schoon per sessie — privacy tussen leerlingen).
mkdir -p "$KIOSK_HOME"
mountpoint -q "$KIOSK_HOME" && umount -l "$KIOSK_HOME" 2>/dev/null || true
mount -t tmpfs -o "mode=0700,uid=${KIOSK_USER},gid=${KIOSK_USER}" tmpfs "$KIOSK_HOME"

chown "$KIOSK_USER":tty "$KIOSK_TTY" 2>/dev/null || true
chmod 620 "$KIOSK_TTY" 2>/dev/null || true

# Per-app browser-policy voor de duur van de sessie (allow_domains → default-deny + allowlist,
# plus extra 'policy'-keys). De policy-dir is globaal → het bestand leeft alleen zolang de kiosk
# draait (kiosk-return + boot-cleanup ruimen het op).
POLICY_JSON="$(/usr/bin/coolbx-kiosk-apps policy "$APP_ID")"
if [ "$POLICY_JSON" != "{}" ]; then
  install -m 0644 /dev/null "$APP_POLICY"
  printf '%s\n' "$POLICY_JSON" > "$APP_POLICY"
else
  rm -f "$APP_POLICY"
fi

# Feature-hooks (bv. focus: lobby-policy). Draaien als root, vóór de sessie start.
if [ -d "$HOOKS_DIR/pre-start" ]; then
  for h in "$HOOKS_DIR"/pre-start/*; do
    [ -x "$h" ] && COOLBX_KIOSK_APP="$APP_ID" "$h" || true
  done
fi

# DEV-ONLY (ADR-0020): CDP-debugvlag doorgeven door systemd-run heen (schone env).
DEBUG_ENV=()
if [ "${COOLBX_KIOSK_DEBUG:-0}" = "1" ]; then
  DEBUG_ENV+=(--property=Environment="COOLBX_KIOSK_DEBUG=1")
fi
if [ -n "${COOLBX_KIOSK_LOAD_EXT:-}" ]; then
  DEBUG_ENV+=(--property=Environment="COOLBX_KIOSK_LOAD_EXT=${COOLBX_KIOSK_LOAD_EXT}")
fi

# Volg GNOME's schaalkeuze (monitors.xml van de startende gebruiker; pkexec zet PKEXEC_UID).
SCALE_ENV=()
GNOME_UID="${PKEXEC_UID:-}"
if [ -n "$GNOME_UID" ]; then
  GNOME_HOME="$(getent passwd "$GNOME_UID" | cut -d: -f6)"
  MON_XML="${GNOME_HOME%/}/.config/monitors.xml"
  if [ -r "$MON_XML" ]; then
    KIOSK_SCALE="$(grep -oE '<scale>[0-9.]+</scale>' "$MON_XML" | head -1 | grep -oE '[0-9.]+' || true)"
    [ -n "${KIOSK_SCALE:-}" ] && SCALE_ENV+=(--property=Environment="COOLBX_KIOSK_SCALE=${KIOSK_SCALE}")
  fi
fi

# Software-rendering alleen in een VM/dev (F-02-050); echte hardware gebruikt de GPU.
RENDER_ENV=()
if [ "${COOLBX_KIOSK_SOFTWARE_RENDER:-0}" = "1" ] \
   || [ "${COOLBX_KIOSK_DEBUG:-0}" = "1" ] \
   || systemd-detect-virt --quiet --vm; then
  RENDER_ENV+=(--property=Environment="WLR_RENDERER=pixman")
  RENDER_ENV+=(--property=Environment="COOLBX_KIOSK_SW_RENDER=1")
fi

# HOME/XDG_RUNTIME_DIR komen van pam_systemd.
systemd-run --unit=coolbx-kiosk --collect \
  --property=User="$KIOSK_USER" \
  --property=PAMName=login \
  --property=TTYPath="$KIOSK_TTY" \
  --property=StandardInput=tty \
  --property=StandardOutput=journal \
  --property=StandardError=journal \
  --property=UtmpIdentifier="tty${VT}" \
  --property=UtmpMode=user \
  --property=SupplementaryGroups="video input render tty" \
  --property=Environment="XKB_DEFAULT_LAYOUT=be" \
  --property=Environment="LANG=nl_BE.UTF-8" \
  --property=Environment="COOLBX_KIOSK_URL=${URL}" \
  --property=Environment="COOLBX_KIOSK_APP=${APP_ID}" \
  "${RENDER_ENV[@]}" \
  "${DEBUG_ENV[@]}" \
  "${SCALE_ENV[@]}" \
  --property="ExecStopPost=+/usr/bin/coolbx-kiosk-return ${RETURN_VT}" \
  /usr/bin/sway -c /usr/share/coolbx/kiosk/sway.conf

sleep 1
chvt "$VT"
# Blokkeer VT-switch tijdens de sessie (S3): Ctrl+Alt+Fn doet niets tot de sessie eindigt.
/usr/bin/coolbx-vt-lock lock || true
