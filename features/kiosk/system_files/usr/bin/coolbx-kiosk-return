#!/usr/bin/env bash
# ExecStopPost van de kiosk-sessie: ontgrendel VT-switch, ruim sessie-policy op, keer terug naar GNOME.
# (Eerst unlock, anders weigert chvt door de VT_LOCKSWITCH.)
set -uo pipefail
/usr/bin/coolbx-vt-lock unlock 2>/dev/null || true
# Per-app sessie-policy weg: de vrije modus mag nooit onder de kiosk-lockdown vallen
# (de browser-policy-dir is globaal).
rm -f /etc/chromium/policies/managed/coolbx-kiosk-app.json
# Feature-hooks (bv. focus: exam-policy clear).
APP="$(cat /run/coolbx-kiosk/app 2>/dev/null || true)"
if [ -d /usr/share/coolbx/kiosk/hooks.d/post-stop ]; then
  for h in /usr/share/coolbx/kiosk/hooks.d/post-stop/*; do
    [ -x "$h" ] && COOLBX_KIOSK_APP="$APP" "$h" || true
  done
fi
rm -f /run/coolbx-kiosk/app /run/coolbx-kiosk/name
# Ephemeral home loskoppelen (ook als er door een race meerdere tmpfs-lagen op staan).
n=0; while mountpoint -q /var/lib/coolbx-kiosk && [ "$n" -lt 20 ]; do umount -l /var/lib/coolbx-kiosk 2>/dev/null || break; n=$((n+1)); done
/usr/bin/chvt "${1:-2}"
