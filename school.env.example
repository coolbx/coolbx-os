# Kopieer naar school.env (GIT-GENEGEERD — bevat geheimen) en vul in. Gebruikt door `just build-iso <rol>`.
CONFIG_REPO_URL="https://github.com/coolbx/coolbx-ansible.git"
IMAGE_REGISTRY="ghcr.io/coolbx/coolbx-os"      # rol-tag wordt eraan geplakt: ghcr.io/coolbx/coolbx-os:leerling
CHANNEL="stabiel"                               # stabiel | test
PROFILE=""                                      # leeg = <rol>-standaard, of een profielnaam uit de config-repo
VAULT_PASS_FILE="$HOME/.config/coolbx/secrets/vault-pass"     # ansible-vault-wachtwoord (make-vault.sh in coolbx-ansible)
ADMIN_HASH_FILE="$HOME/.config/coolbx/secrets/admin-password-hash.txt"   # sha512-crypt: `openssl passwd -6`
